ConnectionStrings__Default=Host=localhost;Port=5432;Database=issuas;Username=issuas;Password=issuas_dev
Jwt__Issuer=IsSuas
Jwt__Audience=IsSuas
Jwt__SigningKey=DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+
Jwt__ExpiryMinutes=480
Storage__Endpoint=http://localhost:9000
Storage__AccessKey=issuas
Storage__SecretKey=issuas_dev_secret
Storage__Bucket=issuas-docs
AspNetCore__Environment=Development

# Režim údržby - núdzový vypínač (vygeneruj vlastné náhodné hodnoty; prázdne = vypínač neexistuje)
# KillSwitchPath: 16-128 znakov A-Z a-z 0-9 - _ ; KillSwitchKey: min. 32 znakov
MaintenanceMode__KillSwitchPath=
MaintenanceMode__KillSwitchKey=
MaintenanceMode__ForceEnabled=false
MaintenanceMode__ForceMessage=

# AI spracovanie PDF manuálov (Technická dokumentácia).
# Ai__Provider: openai (ChatGPT) | gemini | anthropic (Claude). Prázdne = použije sa ten, ktorý má vyplnený kľúč.
Ai__Provider=openai
# ChatGPT — kľúč z platform.openai.com → API keys
OpenAI__ApiKey=
OpenAI__Model=gpt-5-mini
# low = šetrí tokeny; pri modeloch bez reasoningu (napr. gpt-4o) nastavte off
OpenAI__ReasoningEffort=low
# Google Gemini — kľúč z aistudio.google.com → Get API key
Gemini__ApiKey=
Gemini__Model=gemini-flash-latest
# Anthropic Claude — kľúč z console.anthropic.com
Anthropic__ApiKey=
Anthropic__Model=claude-sonnet-5-5
