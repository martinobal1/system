				<name>UAS PUAS001-D</name>
				<Snippet maxLines="0"></Snippet>
				<description><![CDATA[<table style="font-family:Arial,Verdana,Times;font-size:12px;width:100%;border-collapse:collapse;">

<!-- NADPIS -->
<tr style="background:#ff0000;">
<td colspan="2" style="border:1px solid black;padding:8px;text-align:center;font-weight:bold;font-size:16px;">
ZAKÁZANÁ PREVÁDZKA UAS
</td>
</tr>

<!-- OBSAH -->
<tr>
<td style="border:1px solid black;padding:5px;font-weight:bold;">Označenie</td>
<td style="border:1px solid black;padding:5px;">PUAS001-D</td>
</tr>
<tr>
